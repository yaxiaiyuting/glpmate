<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 读取相册图片。
         Android 13+ 用 READ_MEDIA_IMAGES（细分后的图片权限），13 以下退回
         READ_EXTERNAL_STORAGE（用 maxSdkVersion 限定，避免在新系统上要一个已被忽略的权限）。

         为什么需要：选图本身靠 SAF/选择器的 URI 授权就够，**但"按媒体 ID 兜底"那条路
         要用 MediaStore 查图片，没有这个权限必然失败**（部分厂商选择器
         如 ColorOS 的 picker_get_content 返回的 URI 直连读不到，只能走兜底）。
         没有它，兜底等于不存在。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 提醒推送：用 AlarmManager + 本地通知，不引 WorkManager（少一个依赖，
         而且提醒时间是用户设定的固定钟点，不需要 JobScheduler 那套约束） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <application
        android:allowBackup="false"
        android:label="GLP Mate"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.GlpMate">

        <!-- 仅调试构建启用：跳过通知权限弹窗，便于屏幕锁定状态下验证界面。
             正式构建不带这一项（见 app/build.gradle.kts 的 manifestPlaceholders）。 -->
        <meta-data
            android:name="glpmate.skipNotificationPrompt"
            android:value="${skipNotificationPrompt}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.GlpMate">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 到点弹提醒。用 goAsync 之外的最简实现：onReceive 里只做发通知这一件事 -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <!-- 重启后重新排提醒：AlarmManager 的闹钟不跨重启 -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

</application>

    <!--
    Android 11+ 的包可见性：不声明 <queries> 的话，系统会把未声明的 intent
    过滤掉，于是"拍照"直接抛 ActivityNotFoundException 或静默无反应。

    TakePicturePreview() 用的是 android.media.action.IMAGE_CAPTURE，所以必须声明。
    这里**故意不写具体的 <package>**——写死了只有那一个相机 App 可用，
    用户装了别的相机（或系统相机不在该包里）就又会打不开。
    GetContent("image/*") 用的 ACTION_GET_CONTENT 由系统自己处理，不需要声明。

    （这个坑的代价：拍照功能一直点不开，而且不会有任何报错日志。）
    -->
    <queries>
    <intent>
        <action android:name="android.media.action.IMAGE_CAPTURE" />
    </intent>
    </queries>
</manifest>
